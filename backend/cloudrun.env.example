# Environment for the Cloud Run service. Set these with:
#   gcloud run services update meetmind-api --update-env-vars KEY=value
# or, for anything secret, with --set-secrets from Secret Manager.
#
# NEVER pass real keys as plain --update-env-vars in a shared shell: they end
# up in your shell history and in the Cloud Run revision description.

# --- database ---------------------------------------------------------------
# Cloud SQL over the unix socket the connector mounts. INSTANCE is
# project:region:instance, e.g. sayvia-nlr-ai:asia-south1:meetmind-db
DATABASE_URL=mysql+pymysql://meetmind:PASSWORD@/meetmind?unix_socket=/cloudsql/INSTANCE

# --- secrets (use Secret Manager, not plain env vars) -----------------------
RECALL_API_KEY=
RECALL_WEBHOOK_SECRET=
GROQ_API_KEY=
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- public config ----------------------------------------------------------
RECALL_REGION=us-west-2
# The Cloud Run URL. Recall posts webhooks here, so it must be the real
# public address, not localhost.
PUBLIC_BASE_URL=https://meetmind-api-XXXXX.a.run.app
# Must match exactly what is registered in Google Cloud Console.
GOOGLE_OAUTH_REDIRECT_URI=https://meetmind-api-XXXXX.a.run.app/calendar/oauth/callback
# The deployed frontend, for CORS.
CORS_ORIGINS=https://meetmindnlr-ai.web.app

# --- memory -----------------------------------------------------------------
# Hindsight stays on your machine, exposed through a tunnel. The app probes
# this URL before believing it, so if the tunnel is down /health honestly
# reports the MySQL fallback instead of claiming semantic memory it does not
# have. Leave MEMORY_BACKEND=mysql to turn it off entirely.
MEMORY_BACKEND=hindsight
HINDSIGHT_BASE_URL=https://YOUR-HINDSIGHT-TUNNEL.ngrok-free.app

# --- transcription ----------------------------------------------------------
# prioritize_accuracy for a readable record; prioritize_low_latency if you
# are demoing Live Assist and want faster in-call answers.
RECALL_TRANSCRIPT_MODE=prioritize_accuracy
REFINE_WITH_WHISPER=true
