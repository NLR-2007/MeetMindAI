# --- Recall.ai (required) ---
RECALL_API_KEY=your_actual_api_key
# One of: us-west-2 | us-east-1 | eu-central-1 | ap-northeast-1
RECALL_REGION=us-west-2
# Workspace secret for webhook signature verification.
# Recall dashboard > Developers > API Keys & Secrets > Create Workspace Secret
RECALL_WEBHOOK_SECRET=
# Local dev only. Leave false so unsigned webhooks are rejected.
ALLOW_UNVERIFIED_WEBHOOKS=false

# --- Groq LLM (required) ---
GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_WHISPER_MODEL=whisper-large-v3
# GROQ_MAX_TOKENS=4096

# --- Database (required) ---
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/meetmind?charset=utf8mb4

# --- Google Calendar OAuth (for calendar scheduling, not built yet) ---
# Client ID is public by design; the secret is NOT — never ship it to the frontend.
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/calendar/oauth/callback

# --- Optional ---
# Public HTTPS base URL for webhook callbacks in local dev, e.g. an ngrok URL.
# PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app
# BOT_NAME=MeetMind AI Notetaker
# CORS_ORIGINS=http://localhost:3000

# --- Persistent memory (Hindsight) ---
# "hindsight" for real agent memory, "mysql" for the lexical fallback.
MEMORY_BACKEND=hindsight
# Point at a long-lived Hindsight server. Leave empty to start an embedded one
# at boot (slower: it loads models every restart).
HINDSIGHT_BASE_URL=http://127.0.0.1:8888
# NVIDIA NIM is OpenAI-compatible, so Hindsight talks to it via the openai provider.
HINDSIGHT_LLM_PROVIDER=openai
HINDSIGHT_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
HINDSIGHT_LLM_MODEL=openai/gpt-oss-20b
HINDSIGHT_LLM_API_KEY=your_nvidia_nim_key

# --- Authentication ---
# Set this, or every restart signs everyone out.
JWT_SECRET=generate_a_long_random_string
